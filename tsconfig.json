{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2021",
    "lib": ["ES2021"],
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "*.js",
    "auth/**/*.js",
    "database/**/*.js",
    "filesystem/**/*.js",
    "routes/**/*.js",
    "scraper/**/*.js",
    "src/**/*.js",
    "socket.js",
    "upgrade.js",
    "src/**/*.ts",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "package"
  ]
}
