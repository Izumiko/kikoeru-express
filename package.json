{
  "name": "kikoeru-express",
  "version": "0.7.1",
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/XunJiJiang/kikoeru-express",
  "repository": {
    "type": "git",
    "url": "git@github.com:XunJiJiang/kikoeru-express.git"
  },
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "kikoeru-express": "app.js"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js",
      "filesystem/scanner.js",
      "filesystem/updater.js",
      "dist/**/*.js",
      "database/migrations/*",
      "database/knexfile.js",
      "database/storage.js"
    ],
    "assets": [
      "dist/**/*",
      "static/**/*"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "config/*",
      "sqlite/*"
    ],
    "delay": "2500"
  },
  "scripts": {
    "start": "node --trace-warnings app.js",
    "dev": "nodemon --trace-warnings app.js",
    "dev:tsx": "tsx app.js",
    "scan": "node --trace-warnings ./filesystem/scanner.js",
    "build": "pkg package.json --out-path package",
    "build:tauri": "npm run build:quasar && npm run move-quasar && npm run build:mac && npm run build:win && npm run build:linux",
    "build:mac": "pkg package.json --output ../kikoeru-tauri/src-tauri/resources/mac/kikoeru-express --targets node14-macos-x64",
    "build:win": "pkg package.json --output ../kikoeru-tauri/src-tauri/resources/win/kikoeru-express.exe --targets node14-win-x64",
    "build:linux": "pkg package.json --output ../kikoeru-tauri/src-tauri/resources/linux/kikoeru-express --targets node14-linux-x64",
    "build:quasar": "cd ../kikoeru-quasar && npx quasar build",
    "move-quasar": "rm -rf ../kikoeru-express/dist && mv ../kikoeru-quasar/dist/spa ../kikoeru-express/dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "cross-env NODE_ENV=test mocha test/",
    "test": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "author": "Watanuki-Kimihiro",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@umonaca/umzug": "^2.3.1",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "bluebird": "^3.7.2",
    "cheerio": "^1.2.0",
    "compare-versions": "^6.1.1",
    "compression": "^1.8.1",
    "connect-history-api-fallback": "^2.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-beta.22",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "express-validator": "^7.3.2",
    "htmlparser2": "^10.1.0",
    "https": "^1.0.0",
    "invariant": "^2.2.4",
    "jschardet": "^3.1.4",
    "jsonwebtoken": "^9.0.3",
    "knex": "^0.21.17",
    "knex-migrate": "^1.7.4",
    "limit-promise": "^1.0.6",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "natural-orderby": "^5.0.0",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.0.2",
    "tunnel-agent": "^0.6.0",
    "url-join": "^4.0.1",
    "uuid": "^11.1.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.1",
    "chai": "^4.5.0",
    "chai-string": "^1.6.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "eslint": "^10.4.1",
    "eslint-plugin-n": "^18.1.0",
    "globals": "^17.6.0",
    "mocha": "^11.7.6",
    "nodemon": "^3.1.14",
    "serve-index": "^1.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
